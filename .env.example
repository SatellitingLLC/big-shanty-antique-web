ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<32-hex-salt>:<128-hex-scrypt-hash>
SESSION_SECRET=<at-least-32-random-characters>
SITE_URL=https://example.com
DATABASE_URL=<pooled Neon connection string>

NEXT_PUBLIC_WEB3FORMS_KEY=<access key from web3forms.com>

NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page
NEXT_PUBLIC_YELP_URL=https://www.yelp.com/biz/your-business
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle

# Store hours in America/New_York time (EST/EDT handled automatically).
# One range per weekday: 24-hour HH:MM-HH:MM, or "closed" for the whole day.
# Blank/unset falls back to Sun 12:00-18:00, Mon-Sat 10:00-18:00.
NEXT_PUBLIC_STORE_HOURS_SUN=12:00-18:00
NEXT_PUBLIC_STORE_HOURS_MON=10:00-18:00
NEXT_PUBLIC_STORE_HOURS_TUE=10:00-18:00
NEXT_PUBLIC_STORE_HOURS_WED=10:00-18:00
NEXT_PUBLIC_STORE_HOURS_THU=10:00-18:00
NEXT_PUBLIC_STORE_HOURS_FRI=10:00-18:00
NEXT_PUBLIC_STORE_HOURS_SAT=10:00-18:00
